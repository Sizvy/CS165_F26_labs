{"index":5,"title":"Memory Addresses and the Stack","layout":{"id":"ly/ux4ruhcv","name":"TITLE"},"elements":[{"kind":"textbox","text":"Memory Addresses and the Stack","position":{"left":72,"top":46,"width":1136,"height":54.99},"style":{"fontSize":32,"typeface":"Georgia","color":"#15344F","bold":true,"alignment":"left"}},{"kind":"shape","position":{"left":72,"top":113,"width":1136,"height":2.99},"style":{"fontSize":18.67,"typeface":"Arial","color":"#000000","alignment":"left"}},{"kind":"textbox","text":"2","position":{"left":1170,"top":677,"width":38.02,"height":20},"style":{"fontSize":8.67,"typeface":"Georgia","color":"#64717C","alignment":"left"}},{"kind":"textbox","text":"The stack holds the active function calls in a running program.","position":{"left":88,"top":146,"width":1000,"height":32},"style":{"fontSize":18.67,"typeface":"Georgia","color":"#263744","alignment":"left"}},{"kind":"textbox","text":"Course model: Linux on x86-64","position":{"left":145,"top":206,"width":420,"height":28},"style":{"fontSize":15.33,"typeface":"Georgia","color":"#15344F","bold":true,"alignment":"left"}},{"kind":"textbox","text":"higher addresses","position":{"left":130,"top":252,"width":189.98,"height":28},"style":{"fontSize":15.33,"typeface":"Georgia","color":"#64717C","alignment":"left"}},{"kind":"textbox","text":"lower addresses","position":{"left":130,"top":555,"width":189.98,"height":28},"style":{"fontSize":15.33,"typeface":"Georgia","color":"#64717C","alignment":"left"}},{"kind":"shape","position":{"left":340,"top":248,"width":320,"height":350.02},"style":{"fontSize":18.67,"typeface":"Arial","color":"#000000","alignment":"left"}},{"kind":"shape","position":{"left":370,"top":280,"width":260,"height":60},"style":{"fontSize":18.67,"typeface":"Arial","color":"#000000","alignment":"left"}},{"kind":"textbox","text":"Earlier stack data","position":{"left":378,"top":287,"width":244,"height":48},"style":{"fontSize":18,"typeface":"Georgia","color":"#263744","alignment":"left"}},{"kind":"shape","position":{"left":370,"top":340,"width":260,"height":92},"style":{"fontSize":18.67,"typeface":"Arial","color":"#000000","alignment":"left"}},{"kind":"textbox","text":"Current function frame","position":{"left":378,"top":347,"width":244,"height":80},"style":{"fontSize":19,"typeface":"Georgia","color":"#263744","bold":true,"alignment":"left"}},{"kind":"shape","position":{"left":370,"top":462,"width":260,"height":2.99},"style":{"fontSize":18.67,"typeface":"Arial","color":"#000000","alignment":"left"}},{"kind":"textbox","text":"stack pointer: boundary of active stack","position":{"left":365,"top":472,"width":270.02,"height":40},"style":{"fontSize":14.75,"typeface":"Georgia","color":"#15344F","alignment":"left"}},{"kind":"textbox","text":"When a function needs more stack space, the stack grows toward lower addresses.","position":{"left":755,"top":290,"width":350.02,"height":70.02},"style":{"fontSize":16.77,"typeface":"Georgia","color":"#15344F","bold":true,"alignment":"left"}},{"kind":"textbox","text":"In this course, “above” means a higher address and “below” means a lower address. A compiler can arrange details differently, but the boundary rule for an array never changes.","position":{"left":755,"top":396,"width":350.02,"height":150.02},"style":{"fontSize":19,"typeface":"Georgia","color":"#263744","alignment":"left"}}]}
